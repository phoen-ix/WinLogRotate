<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinLogRotate.Core</RootNamespace>

    <!-- The engine is consumed by the NativeAOT CLI, so it must stay AOT-clean.
         This enables the AOT/trim analyzers at BUILD time, which is what actually
         keeps the promise honest - the first reflection-using package otherwise
         sneaks in unnoticed and is discovered by the CLI six months later. -->
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Required by [LibraryImport], the source-generated P/Invoke the AOT toolchain wants.
         It generates the marshalling code at compile time instead of at runtime, which is
         what makes the interop AOT-safe; the generated stubs are unsafe by construction.
         The alternative, [DllImport], needs no unsafe flag but relies on the runtime
         marshaller that NativeAOT is trying to get away from. No hand-written unsafe code
         exists in this project - only the generated stubs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Plain net10.0, NOT net10.0-windows: this keeps the project restorable and
         type-checkable on a Linux CI runner, so ~70% of the test suite runs there.
         The Windows-only surface is declared per-assembly in AssemblyInfo.cs instead,
         which satisfies CA1416 without pinning the TFM to Windows. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The only .NET TOML library with a full-fidelity syntax tree: comments and formatting
         survive a parse-mutate-write cycle, which is what lets the GUI edit one value in a
         hand-written config without vandalising the rest of it. -->
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WinLogRotate.Contracts/WinLogRotate.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinLogRotate.Core.Tests" />
    <InternalsVisibleTo Include="WinLogRotate.Windows.Tests" />
    <InternalsVisibleTo Include="WinLogRotate.Snapshot.Tests" />
    <InternalsVisibleTo Include="WinLogRotate.Hosting" />
    <InternalsVisibleTo Include="WinLogRotate.Cli" />
  </ItemGroup>

</Project>
