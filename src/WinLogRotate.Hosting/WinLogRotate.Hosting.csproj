<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinLogRotate.Hosting</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>

    <!-- Required by [LibraryImport] in Diagnostics/EventLogNative.cs. Same reasoning as Core:
         the generated marshalling stubs are unsafe by construction, and no hand-written
         unsafe code exists in this project. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI. Not in the shared framework for a plain net10.0 target - it ships only in the
         Windows Desktop one - so the CLI has to reference it explicitly. Reflection-free and
         AOT-clean, and it compiles into the native image rather than appearing as an import,
         so the "zero dependencies" gate in CI is unaffected: the published exe still imports
         nothing but OS DLLs.

         Note it carries NO [SupportedOSPlatform("windows")] attribute of its own, so CA1416
         will not warn about calling it from platform-neutral code - it simply throws
         PlatformNotSupportedException at runtime, on a suite that is mostly Linux. That is
         why DpapiMachineProtector wraps it in a type that IS annotated. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../WinLogRotate.Core/WinLogRotate.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinLogRotate.Core.Tests" />
    <InternalsVisibleTo Include="WinLogRotate.Windows.Tests" />
    <InternalsVisibleTo Include="WinLogRotate.Snapshot.Tests" />
  </ItemGroup>

</Project>
