<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="WinLogRotate.gui" />

  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!-- asInvoker. The GUI must never elevate itself at launch: editing a config
             should not raise a UAC prompt, and an elevated window loses unsaved state on
             relaunch and can no longer accept drag-drop from Explorer (UIPI blocks it).
             Privileged work is done by launching an elevated CHILD winlogrotate.exe and
             streaming its output back. UAC shields go on the individual buttons. -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Without this, every log path over 260 characters fails silently. Needs the
           machine-wide LongPathsEnabled registry flag too, which `winlogrotate doctor`
           reports and the installer offers to set. Belt and braces: the engine also
           \\?\-prefixes destructive operations regardless, since that flag is machine
           policy we don't control. -->
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 / Server 2016 and later -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
