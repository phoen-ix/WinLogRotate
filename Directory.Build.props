<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning here means the code isn't doing what it reads like it does. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Placeholder only: CI injects the real version via -p:Version (release.yml).
         Local builds show an obviously-dev v0.0.0 instead of a stale-looking number.
         The app reads it back with Assembly.GetName().Version. -->
    <Version>0.0.0-dev</Version>

    <Product>WinLogRotate</Product>
    <Company>phoen-ix</Company>
    <Authors>phoen-ix</Authors>
    <Copyright>Copyright (c) 2026 phoen-ix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- Nothing here is localized yet; every user-facing string goes through the
         Strings resource layer so adding a language later is a translation job,
         not a refactor. Until then, don't carry satellite assemblies around. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <!-- Lets the Windows-desktop (WinForms) project restore and type-check on a Linux
         CI runner or dev box. The runnable exe is still built on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Deterministic>true</Deterministic>

    <!-- On, because the doc comments here ARE the design record and nothing was checking them.
         This was false, two lines below TreatWarningsAsErrors, so the compiler never once looked
         at a <param> name - and NulFillDetector documented a parameter called leadingNulBytes
         that has never existed, while FileOps stacked two <summary> blocks so Create ended up
         with neither of them.

         CS1573 is suppressed deliberately. It fires when SOME parameters are documented and
         others are not, and there are 62 <param> tags across this repository, most of them the
         only one on their member - documenting the parameter that needs explaining and leaving
         the obvious ones alone is a habit worth keeping, not a defect. What is kept is CS1572,
         a <param> naming a parameter that does not exist, and CS1571, the same one twice: both
         are unambiguously wrong rather than a matter of taste.

         Note what this still cannot see: two <summary> blocks on one member produce no warning
         under any of these. Those are found by reading. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1573;CS1591</NoWarn>

    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- x64 only for 1.0. There is no arm64 gate: this said there was one, wired into CI as a
       build-only check, and a grep for arm64 across the whole repository returned that sentence
       and nothing else. A comment describing a check that does not exist is worse than no check,
       because it stops anyone adding one. -->
  <PropertyGroup>
    <Platforms>AnyCPU</Platforms>
    <DefaultWinLogRotateRid>win-x64</DefaultWinLogRotateRid>
  </PropertyGroup>

</Project>
