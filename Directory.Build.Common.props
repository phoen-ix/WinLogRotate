<Project>

  <!-- The build settings WinLogRotate, displayRotate and pawse share. This file is canonical;
       the other two carry fleet-copy marked copies (fleet copies reports drift). Repo-specific
       settings stay in each repo's Directory.Build.props, which imports this. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning here means the code isn't doing what it reads like it does. NuGet advisories
         stay warnings: net11.0 audits the whole transitive closure, CI's audit step fails on
         them explicitly, and a new advisory should not turn an unchanged build red. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;$(WarningsNotAsErrors)</WarningsNotAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <!-- latest-recommended minus the rules that are noise in these repos:
         CA1707 Win32 constants keep their header names (VK_LSHIFT); test names use _ as a separator.
         CA1711 xunit collection definitions are named *Collection by convention.
         CA1716 a keyword clash only matters to VB callers, and there are none.
         CA1720 TOML's value kinds are called String and Integer.
         CA1822 the instance members it flags are deliberate API (PathGuard's decisions, layouts).
         CA1859 the IReadOnly* parameter and return types are the intended contract.
         CA1861 and CA1863 allocation micro-optimisations, all of them in tests.
         1701;1702 are the SDK default, which any NoWarn set before it replaces. -->
    <NoWarn>$(NoWarn);1701;1702;CA1707;CA1711;CA1716;CA1720;CA1822;CA1859;CA1861;CA1863</NoWarn>

    <!-- Lets the Windows-desktop (WinForms/WPF) projects restore and type-check on a Linux CI
         runner or dev box. The runnable exe is still built on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
