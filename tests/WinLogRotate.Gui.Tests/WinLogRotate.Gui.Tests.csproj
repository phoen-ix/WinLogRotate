<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The one project that opens the real window. It needs Microsoft.WindowsDesktop.App, so it
         cannot even start on Linux - which is why it is not in WinLogRotate.slnx: `dotnet test
         WinLogRotate.slnx` keeps working on a Linux box. scripts/docs-screenshots.sh runs it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WinLogRotate.Gui.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/WinLogRotate.Gui/WinLogRotate.Gui.csproj" />

    <!-- The window shells out to the winlogrotate.exe beside itself (CliRunner.Resolve), so the
         CLI has to land in this project's output, as it does in an install. -->
    <ProjectReference Include="../../src/WinLogRotate.Cli/WinLogRotate.Cli.csproj" />
  </ItemGroup>

</Project>
